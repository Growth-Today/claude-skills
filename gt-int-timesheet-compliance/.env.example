# Copy to .env for local runs. For a scheduled Routine these must be environment
# variables on the remote environment instead, because each run starts a fresh
# container that never sees your local .env.
#
# Asana personal access token. Settings, Apps, Manage developer apps, Personal
# access tokens. A PAT carries your full user scope, which the time tracking
# endpoints need. Never commit this file.
ASANA_ACCESS_TOKEN=

# The workspace whose time entries you are scoring.
ASANA_WORKSPACE_GID=
