# gt-email-infra — copy to .env and fill in. NEVER commit .env.
#
# Only needed for playbooks that talk to a sending platform. The DNS and
# sizing playbooks need nothing here.

# Instantly V2 — https://app.instantly.ai/app/settings/integrations
# ⚠️ READ-ONLY KEY ONLY for anything a GTM engineer runs.
# Sending limits, warmup config, tagging and routing belong to the email infra management system.
# A key that can PATCH /accounts stays with that system, not with a GTM engineer.
INSTANTLY_API_KEY=

# Lemlist v1 — Settings -> Integrations -> API
# Auth is HTTP Basic with an EMPTY username: curl --user ":$LEMLIST_API_KEY"
# Lemlist does not split read and write scopes, so this key can also write.
# Treat it as privileged: never paste it into chat or a ticket, rotate if you do.
LEMLIST_API_KEY=

# HeyReach (LinkedIn side, used by gt-linkedin-outbound)
HEYREACH_API_KEY=
