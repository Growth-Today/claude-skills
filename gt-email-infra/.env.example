# gt-email-infra — copy to .env and fill in. NEVER commit .env.
#
# Only needed for playbooks that talk to a sending platform. The DNS and
# sizing playbooks need nothing here.

# Instantly V2 — https://app.instantly.ai/app/settings/integrations
# ⚠️ READ-ONLY KEY ONLY for anything a GTM engineer runs.
# Sending limits, warmup config, tagging and routing are OpsLab-owned.
# A key that can PATCH /accounts must stay with OpsLab.
INSTANTLY_API_KEY=

# HeyReach (LinkedIn side, used by gt-linkedin-outbound)
HEYREACH_API_KEY=
